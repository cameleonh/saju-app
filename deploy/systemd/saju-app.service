[Unit]
Description=Saju app Node service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/saju-app
Environment=NODE_ENV=production
Environment=PORT=4174
Environment=SAJU_STORAGE=local-only
EnvironmentFile=-/etc/saju-app.env
EnvironmentFile=-/etc/saju-app-aws.env
ExecStart=/usr/bin/node /var/www/saju-app/server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/saju-app/runtime

[Install]
WantedBy=multi-user.target
